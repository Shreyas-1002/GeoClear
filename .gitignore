*.py[cod]
*$py.class
*.so

# Environments & Virtual Envs
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Logs and temporary files
*.log
*.tmp
*.temp
.cache/
.pytest_cache/
.ipynb_checkpoints/

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# Archives & Local GIS Project Files
*.zip
*.tar
*.gz
*.rar
*.7z
*.qgz
*.qgs

# Model Checkpoints & Pretrained Weights (Excluded per size & licensing constraints)
*.pth
*.pt
*.ckpt
*.h5
*.hdf5
*.bin
*.onnx
models/**/checkpoints/
models/**/pretrained/
models/DSen2-CR/checkpoints/
models/ECRformer/ECRformer-master/pretrained/
models/DiffCR/DiffCR-main/pretrained/

# Large Raw Satellite Datasets & GeoTIFF Rasters (Excludes raw S1/S2 data, keeps manifests)
*.tif
*.tiff
data/**/*.tif
data/**/*.tiff

# Large Experiment Outputs & Generated Inference Artifacts
outputs/
*.npz

